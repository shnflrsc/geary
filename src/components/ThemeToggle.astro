---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`relative shrink-0 ${className}`}>
  <button
    id="theme-toggle-button"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="theme-toggle-menu"
    aria-label="Choose color theme"
    class="inline-flex min-h-[44px] min-w-[44px] md:min-h-[40px] md:min-w-[40px] md:h-10 md:w-10 cursor-pointer items-center justify-center rounded-lg border border-border-subtle bg-surface-card text-ink-primary hover:border-brand-crimson hover:text-brand-crimson transition-colors duration-150"
  >
    <!-- Sun icon (resolved light) -->
    <svg
      data-theme-trigger-icon="light"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-[18px] w-[18px]"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
    </svg>
    <!-- Crescent moon icon (resolved dark) -->
    <svg
      data-theme-trigger-icon="dark"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-[18px] w-[18px]"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </button>

  <div
    id="theme-toggle-menu"
    role="menu"
    aria-label="Color theme"
    class="hidden absolute right-0 top-full z-50 mt-2 w-48 rounded-xl border border-border-subtle bg-surface-card p-1.5 shadow-lg"
  >
    <button
      type="button"
      role="menuitemradio"
      data-theme-option="light"
      aria-checked="false"
      tabindex="-1"
      class="flex min-h-[44px] w-full cursor-pointer items-center justify-between gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-ink-primary hover:bg-surface-subtle focus-visible:bg-surface-subtle transition-colors duration-150"
    >
      <span class="flex items-center gap-2.5">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 shrink-0"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
        </svg>
        <span>Light</span>
      </span>
      <svg
        data-theme-check
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden h-4 w-4 shrink-0 text-brand-crimson"
      >
        <path d="m4.5 10.5 3.5 3.5 7.5-8" />
      </svg>
    </button>

    <button
      type="button"
      role="menuitemradio"
      data-theme-option="dark"
      aria-checked="false"
      tabindex="-1"
      class="flex min-h-[44px] w-full cursor-pointer items-center justify-between gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-ink-primary hover:bg-surface-subtle focus-visible:bg-surface-subtle transition-colors duration-150"
    >
      <span class="flex items-center gap-2.5">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 shrink-0"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
        <span>Dark</span>
      </span>
      <svg
        data-theme-check
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden h-4 w-4 shrink-0 text-brand-crimson"
      >
        <path d="m4.5 10.5 3.5 3.5 7.5-8" />
      </svg>
    </button>

    <button
      type="button"
      role="menuitemradio"
      data-theme-option="system"
      aria-checked="false"
      tabindex="-1"
      class="flex min-h-[44px] w-full cursor-pointer items-center justify-between gap-2.5 rounded-lg px-3 py-2 text-left text-sm font-medium text-ink-primary hover:bg-surface-subtle focus-visible:bg-surface-subtle transition-colors duration-150"
    >
      <span class="flex items-center gap-2.5">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 shrink-0"
        >
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8m-4-4v4" />
        </svg>
        <span>System default</span>
      </span>
      <svg
        data-theme-check
        aria-hidden="true"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2.25"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden h-4 w-4 shrink-0 text-brand-crimson"
      >
        <path d="m4.5 10.5 3.5 3.5 7.5-8" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'geary-theme';
    const trigger = document.getElementById('theme-toggle-button');
    const menu = document.getElementById('theme-toggle-menu');
    if (!trigger || !menu) return;

    const options = Array.from(menu.querySelectorAll('[data-theme-option]'));
    const sunIcon = trigger.querySelector('[data-theme-trigger-icon="light"]');
    const moonIcon = trigger.querySelector('[data-theme-trigger-icon="dark"]');
    const mediaQuery =
      typeof window.matchMedia === 'function'
        ? window.matchMedia('(prefers-color-scheme: dark)')
        : null;

    const readPreference = () => {
      try {
        const saved = window.localStorage.getItem(KEY);
        if (saved === 'light' || saved === 'dark' || saved === 'system') {
          return saved;
        }
      } catch {}
      const fromDom = document.documentElement.dataset.themePreference;
      if (fromDom === 'light' || fromDom === 'dark' || fromDom === 'system') {
        return fromDom;
      }
      return 'system';
    };

    const writePreference = (pref) => {
      try {
        window.localStorage.setItem(KEY, pref);
      } catch {}
    };

    const applyTheme = (pref) => {
      const systemDark = Boolean(mediaQuery && mediaQuery.matches);
      const isDark = pref === 'dark' || (pref === 'system' && systemDark);
      const root = document.documentElement;
      root.classList.toggle('dark', isDark);
      root.dataset.themePreference = pref;
      root.dataset.themeResolved = isDark ? 'dark' : 'light';
      root.style.colorScheme = isDark ? 'dark' : 'light';

      if (sunIcon && moonIcon) {
        sunIcon.classList.toggle('hidden', isDark);
        moonIcon.classList.toggle('hidden', !isDark);
      }

      for (const option of options) {
        const isSelected = option.getAttribute('data-theme-option') === pref;
        option.setAttribute('aria-checked', String(isSelected));
        option.classList.toggle('bg-brand-crimson-wash', isSelected);
        option.classList.toggle('text-brand-crimson', isSelected);
        option.classList.toggle('font-semibold', isSelected);
        const check = option.querySelector('[data-theme-check]');
        if (check) check.classList.toggle('hidden', !isSelected);
      }
    };

    let isOpen = false;

    const closeMenu = (restoreFocus = false) => {
      if (!isOpen) return;
      isOpen = false;
      trigger.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
      if (restoreFocus) trigger.focus();
    };

    const openMenu = (focusTarget = 'selected') => {
      isOpen = true;
      trigger.setAttribute('aria-expanded', 'true');
      menu.classList.remove('hidden');
      let target = options[0];
      if (focusTarget === 'last') {
        target = options[options.length - 1];
      } else if (focusTarget === 'selected') {
        target = options.find((o) => o.getAttribute('aria-checked') === 'true') || options[0];
      }
      if (target) target.focus();
    };

    applyTheme(readPreference());

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closeMenu(false);
      } else {
        openMenu('selected');
      }
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openMenu('selected');
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        openMenu('last');
      }
    });

    menu.addEventListener('keydown', (event) => {
      const idx = options.indexOf(document.activeElement);
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        const next = options[(idx + 1 + options.length) % options.length];
        if (next) next.focus();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        const prevIndex = idx <= 0 ? options.length - 1 : idx - 1;
        const prev = options[prevIndex];
        if (prev) prev.focus();
      } else if (event.key === 'Home') {
        event.preventDefault();
        if (options[0]) options[0].focus();
      } else if (event.key === 'End') {
        event.preventDefault();
        if (options[options.length - 1]) options[options.length - 1].focus();
      } else if (event.key === 'Tab') {
        closeMenu(false);
      }
    });

    for (const option of options) {
      option.addEventListener('click', () => {
        const pref = option.getAttribute('data-theme-option');
        if (pref === 'light' || pref === 'dark' || pref === 'system') {
          writePreference(pref);
          applyTheme(pref);
          closeMenu(true);
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (isOpen && !menu.contains(event.target) && !trigger.contains(event.target)) {
        closeMenu(false);
      }
    });

    if (mediaQuery) {
      const onSystemChange = () => {
        if (readPreference() === 'system') {
          applyTheme('system');
        }
      };
      if (typeof mediaQuery.addEventListener === 'function') {
        mediaQuery.addEventListener('change', onSystemChange);
      }
    }
  })();
</script>
