---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES, type CategoryMeta } from '../../data/categories';
import { groupArticlesBySubcategory } from '../../lib/articles';
import { buildBreadcrumbJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: CategoryMeta;
}

const { category } = Astro.props;
const allArticles = await getCollection('articles');
const categoryArticles = allArticles.filter(
  (entry) => entry.data.category === category.slug,
);
const subcategoryGroups = groupArticlesBySubcategory(categoryArticles);
const baseOrigin = Astro.site ?? new URL(Astro.url.origin);
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Home', url: new URL('/', baseOrigin).href },
  { name: 'Articles', url: new URL('/articles', baseOrigin).href },
  { name: category.title },
]);
---

<BaseLayout
  title={`${category.title} - Geary`}
  description={category.description}
  activeCategory={category.slug}
  jsonLd={breadcrumbJsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mb-10 border-b border-border-subtle pb-6 max-w-3xl">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Articles', href: '/articles' },
          { label: category.title },
        ]}
      />

      <h1 class="font-heading text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] tracking-[-0.02em] text-ink-primary">
        {category.title}
      </h1>
    </div>

    {
      subcategoryGroups.length > 0 ? (
        <div class="space-y-10">
          {subcategoryGroups.map((group, idx) => {
            const slugPart = group.subcategory
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '');
            const headingId = slugPart ? `sub-${slugPart}` : `sub-group-${idx}`;
            return (
              <section aria-labelledby={headingId}>
                <h2
                  id={headingId}
                  class="mb-4 font-heading text-lg sm:text-xl font-bold text-ink-primary"
                >
                  {group.subcategory}
                </h2>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-6">
                  {group.articles.map((article) => (
                    <ArticleCard article={article} />
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-14 text-center">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="h-8 w-8 text-ink-muted"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
            />
          </svg>
          <p class="mt-3 text-sm font-medium text-ink-secondary">
            No articles here yet.
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
