---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CategoryMeta } from '../data/categories';
import {
  formatArticleDate,
  getArticlePreview,
  resolveArticleSources,
  type ArticleLike,
} from '../lib/articles';
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from '../lib/seo';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: ArticleLike;
  categoryMeta: CategoryMeta;
  headings: Heading[];
}

const { article, categoryMeta, headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;
const resolvedSources = resolveArticleSources(article.data);
const articlePreview = getArticlePreview(article);
const baseOrigin = Astro.site ?? new URL(Astro.url.origin);
const articleUrl = new URL(Astro.url.pathname, baseOrigin).href;
const jsonLd = [
  buildArticleJsonLd({
    title: article.data.title,
    description: articlePreview,
    url: articleUrl,
    dateModified: article.data.updatedDate,
    section: categoryMeta.title,
    source: article.data.source,
    sourceUrl: article.data.sourceUrl,
    sources: article.data.sources,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', baseOrigin).href },
    { name: 'Articles', url: new URL('/articles', baseOrigin).href },
    { name: categoryMeta.title, url: new URL(`/categories/${categoryMeta.slug}`, baseOrigin).href },
    { name: article.data.title },
  ]),
];
---

<BaseLayout
  title={article.data.title}
  description={articlePreview}
  activeCategory={categoryMeta.slug}
  ogType="article"
  ogImageAlt={`${article.data.title} - Geary BulSU Student Article`}
  articleMeta={{
    modifiedTime: article.data.updatedDate.toISOString(),
    section: categoryMeta.title,
    tag: article.data.subcategory,
  }}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mb-8 border-b border-border-subtle pb-6 max-w-[65ch]">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Articles', href: '/articles' },
          { label: categoryMeta.title, href: `/categories/${categoryMeta.slug}` },
          { label: article.data.title },
        ]}
      />

      <h1 class="mt-8 font-heading text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] tracking-[-0.02em] text-ink-primary">
        {article.data.title}
      </h1>

      <p class="mt-4 text-xs font-medium text-ink-secondary">
        Last Updated: {formatArticleDate(article.data.updatedDate)}
      </p>
    </div>

    <div
      class={
        hasToc
          ? 'lg:grid lg:grid-cols-[minmax(0,65ch)_260px] lg:gap-12 lg:items-start'
          : 'max-w-[65ch]'
      }
    >
      <div class="min-w-0">
        <TableOfContents headings={headings} mode="mobile" />

        <article class="geary-prose">
          <slot />
        </article>

        {
          resolvedSources.length > 0 && (
            <aside
              aria-label="Article source"
              class="mt-8 rounded-xl border border-border-subtle bg-surface-card p-4 sm:p-5"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-secondary">
                {resolvedSources.length === 1 ? 'Source' : 'Sources'}
              </p>
              <ul class="mt-2 space-y-1.5">
                {resolvedSources.map((item) => (
                  <li>
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-baseline gap-1.5 text-sm font-medium text-brand-crimson hover:text-brand-crimson-hover hover:underline underline-offset-2 transition-colors"
                      >
                        <span>{item.label}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <p class="text-sm font-medium text-ink-primary">{item.label}</p>
                    )}
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>

      {hasToc && <TableOfContents headings={headings} mode="desktop" />}
    </div>
  </div>
</BaseLayout>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('.geary-prose table')) {
    table.setAttribute('tabindex', '0');

    const parent = table.parentElement;
    if (!parent || parent.classList.contains('table-scroll-wrap')) continue;

    const shell = document.createElement('div');
    shell.className = 'table-scroll-shell';

    const hint = document.createElement('p');
    hint.className = 'table-scroll-hint';
    hint.setAttribute('aria-hidden', 'true');
    hint.textContent = 'Scroll →';

    const wrap = document.createElement('div');
    wrap.className = 'table-scroll-wrap';

    parent.insertBefore(shell, table);
    shell.appendChild(hint);
    shell.appendChild(wrap);
    wrap.appendChild(table);

    const updateScrollState = () => {
      const maxScroll = Math.max(0, table.scrollWidth - table.clientWidth);
      const overflows = maxScroll > 2;
      shell.dataset.overflows = String(overflows);
      wrap.dataset.canScrollLeft = String(overflows && table.scrollLeft > 2);
      wrap.dataset.canScrollRight = String(overflows && table.scrollLeft < maxScroll - 2);
    };

    table.addEventListener('scroll', updateScrollState, { passive: true });
    window.addEventListener('resize', updateScrollState, { passive: true });
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(updateScrollState).observe(table);
    }
    updateScrollState();
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '.geary-prose a[href^="http://"], .geary-prose a[href^="https://"]',
  )) {
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    if (!link.querySelector('.sr-only')) {
      const note = document.createElement('span');
      note.className = 'sr-only';
      note.textContent = ' (opens in new tab)';
      link.appendChild(note);
    }
  }

  for (const heading of document.querySelectorAll('.geary-prose h2[id], .geary-prose h3[id]')) {
    const id = heading.getAttribute('id');
    const title = heading.textContent?.trim();
    if (!id || !title || heading.querySelector('.heading-anchor')) continue;

    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${id}`;
    anchor.setAttribute('aria-label', `Link to ${title}`);
    anchor.textContent = '#';
    anchor.addEventListener('click', () => {
      const url = `${window.location.origin}${window.location.pathname}#${id}`;
      navigator.clipboard?.writeText(url).catch(() => {});
    });
    heading.appendChild(anchor);
  }
</script>
