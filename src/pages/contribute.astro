---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const FORM_EMBED_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSe3P-px2ZmV6IofZNfWWES9ivfcn4HHjQ5W7c0iTXB_KxXmOw/viewform?embedded=true';
const FORM_DIRECT_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSe3P-px2ZmV6IofZNfWWES9ivfcn4HHjQ5W7c0iTXB_KxXmOw/viewform';

const CHECKLIST_ITEMS = [
  'Include an official BulSU source link or reference (Student Manual, Registrar memo, bulsu.edu.ph, or official BulSU Facebook post).',
  'Set Google Docs sharing to Anyone with the link (Viewer) before pasting a draft link.',
  "Expect maintainers to verify facts and edit submissions for clarity into Geary's style before publishing.",
];
---

<BaseLayout
  title="Contribute - Geary"
  description="Report an outdated BulSU article, submit a student-written draft, or suggest a missing campus topic for Geary."
  activeNav="contribute"
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mb-8 border-b border-border-subtle pb-6 max-w-[65ch]">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Contribute' },
        ]}
      />

      <h1 class="mt-8 font-heading text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] tracking-[-0.02em] text-ink-primary">
        Contribute to Geary
      </h1>
    </div>

    <div class="max-w-3xl space-y-6">
      <div class="rounded-xl border border-border-subtle bg-white p-5 sm:p-6">
        <h2 class="font-heading text-base font-bold text-ink-primary">
          Before you submit
        </h2>
        <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-ink-secondary">
          {
            CHECKLIST_ITEMS.map((item) => (
              <li class="flex items-start gap-2.5">
                <span
                  aria-hidden="true"
                  class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded bg-brand-crimson text-white"
                >
                  <svg viewBox="0 0 16 16" fill="none" class="h-3 w-3" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 8.5 6.5 11.5 12.5 5" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <section aria-label="Contribution submission form" class="space-y-3">
        <div class="flex justify-end">
          <a
            href={FORM_DIRECT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-crimson hover:text-brand-crimson-hover hover:underline underline-offset-2 transition-colors"
          >
            <span>Open form in a new tab</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="overflow-hidden rounded-xl border border-border-subtle bg-white">
          <iframe
            src={FORM_EMBED_URL}
            title="Contribute to Geary Google Form"
            loading="eager"
            class="block h-[700px] sm:h-[640px] w-full border-0"
          >
            Loading submission form...
          </iframe>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
