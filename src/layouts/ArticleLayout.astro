---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { CategoryMeta } from '../data/categories';
import {
  formatArticleDate,
  getArticlePreview,
  resolveArticleSources,
  type ArticleLike,
} from '../lib/articles';
import { buildArticleJsonLd, buildBreadcrumbJsonLd, resolveSiteOrigin } from '../lib/seo';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: ArticleLike;
  categoryMeta: CategoryMeta;
  headings: Heading[];
}

const { article, categoryMeta, headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;
const resolvedSources = resolveArticleSources(article.data);
const articlePreview = getArticlePreview(article);
const baseOrigin = resolveSiteOrigin(Astro.site, Astro.url);
const articleUrl = new URL(Astro.url.pathname, baseOrigin).href;
const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`;
const jsonLd = [
  buildArticleJsonLd({
    title: article.data.title,
    description: articlePreview,
    url: articleUrl,
    dateModified: article.data.updatedDate,
    section: categoryMeta.title,
    source: article.data.source,
    sourceUrl: article.data.sourceUrl,
    sources: article.data.sources,
  }),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: new URL('/', baseOrigin).href },
    { name: 'Articles', url: new URL('/articles', baseOrigin).href },
    { name: categoryMeta.title, url: new URL(`/categories/${categoryMeta.slug}`, baseOrigin).href },
    { name: article.data.title },
  ]),
];
---

<BaseLayout
  title={article.data.title}
  description={articlePreview}
  activeCategory={categoryMeta.slug}
  ogType="article"
  ogImageAlt={`${article.data.title} - Geary BulSU Student Article`}
  articleMeta={{
    modifiedTime: article.data.updatedDate.toISOString(),
    section: categoryMeta.title,
    tag: article.data.subcategory,
  }}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="mb-8 border-b border-border-subtle pb-6 max-w-[65ch]">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Articles', href: '/articles' },
          { label: categoryMeta.title, href: `/categories/${categoryMeta.slug}` },
          { label: article.data.title },
        ]}
      />

      <h1 class="mt-8 font-heading text-[1.75rem] sm:text-[2.25rem] font-bold leading-[1.2] tracking-[-0.02em] text-ink-primary">
        {article.data.title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
        <p class="text-xs font-medium text-ink-secondary">
          Last Updated: {formatArticleDate(article.data.updatedDate)}
        </p>

        <div
          role="group"
          aria-label="Share this article"
          class="flex items-center gap-0.5 text-ink-secondary opacity-80 transition-opacity duration-150 hover:opacity-100 focus-within:opacity-100"
        >
          <button
            type="button"
            id="article-native-share"
            data-share-title={article.data.title}
            data-share-url={articleUrl}
            aria-label="Share"
            title="Share"
            class="hidden h-7 w-7 cursor-pointer items-center justify-center rounded-md text-xs font-medium transition-colors duration-150 hover:bg-surface-subtle hover:text-brand-crimson focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-crimson"
          >
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-7-5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm1.7-1.1 3.6-2.1m-3.6 3.3 3.6 2.1" />
            </svg>
          </button>

          <a
            href={fbShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
            title="Share on Facebook"
            class="inline-flex h-7 w-7 items-center justify-center rounded-md text-xs font-medium transition-colors duration-150 hover:bg-surface-subtle hover:text-brand-crimson focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-crimson"
          >
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5">
              <path d="M11.5 17.5v-6.8h2.3l.35-2.65H11.5V6.35c0-.77.22-1.3 1.32-1.3h1.41V2.68c-.24-.03-1.08-.1-2.06-.1-2.04 0-3.44 1.24-3.44 3.53v1.94H6.4v2.65h2.33v6.8h2.77Z" />
            </svg>
          </a>

          <button
            type="button"
            id="article-copy-link"
            aria-label="Copy link"
            title="Copy link"
            class="inline-flex h-7 min-w-7 cursor-pointer items-center justify-center gap-1 rounded-md px-1.5 text-xs font-medium transition-colors duration-150 hover:bg-surface-subtle hover:text-brand-crimson focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-crimson"
          >
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" class="h-3.5 w-3.5 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 11.5a3.5 3.5 0 0 0 4.95 0l2.12-2.12a3.5 3.5 0 0 0-4.95-4.95L9.4 5.65m2.1 2.85a3.5 3.5 0 0 0-4.95 0L4.43 10.62a3.5 3.5 0 1 0 4.95 4.95l1.2-1.2" />
            </svg>
            <span id="article-copy-label" class="hidden">Copied</span>
          </button>
        </div>
      </div>
    </div>

    <div
      class={
        hasToc
          ? 'lg:grid lg:grid-cols-[minmax(0,65ch)_260px] lg:gap-12 lg:items-start'
          : 'max-w-[65ch]'
      }
    >
      <div class="min-w-0">
        <TableOfContents headings={headings} mode="mobile" />

        <article class="geary-prose">
          <slot />
        </article>

        {
          resolvedSources.length > 0 && (
            <aside
              aria-label="Article source"
              class="mt-8 rounded-xl border border-border-subtle bg-surface-card p-4 sm:p-5"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-secondary">
                {resolvedSources.length === 1 ? 'Source' : 'Sources'}
              </p>
              <ul class="mt-2 space-y-1.5">
                {resolvedSources.map((item) => (
                  <li>
                    {item.url ? (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-baseline gap-1.5 text-sm font-medium text-brand-crimson hover:text-brand-crimson-hover hover:underline underline-offset-2 transition-colors"
                      >
                        <span>{item.label}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <p class="text-sm font-medium text-ink-primary">{item.label}</p>
                    )}
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>

      {hasToc && <TableOfContents headings={headings} mode="desktop" />}
    </div>
  </div>
</BaseLayout>

<script>
  for (const table of document.querySelectorAll<HTMLTableElement>('.geary-prose table')) {
    table.setAttribute('tabindex', '0');

    const rows = Array.from(table.rows);
    const colCount = rows[0]?.cells.length ?? 0;
    if (colCount >= 2) {
      for (let col = 0; col < colCount; col++) {
        let maxLen = 0;
        for (const row of rows) {
          const text = row.cells[col]?.textContent?.trim() ?? '';
          if (text.length > maxLen) maxLen = text.length;
        }
        const minW = maxLen >= 100 ? '15rem' : maxLen >= 45 ? '11rem' : '';
        if (minW) {
          const headerCell = rows[0]?.cells[col];
          if (headerCell) headerCell.style.minWidth = minW;
        }
      }
    }

    const parent = table.parentElement;
    if (!parent || parent.classList.contains('table-scroll-wrap')) continue;

    const wrap = document.createElement('div');
    wrap.className = 'table-scroll-wrap';

    parent.insertBefore(wrap, table);
    wrap.appendChild(table);

    const updateScrollState = () => {
      const maxScroll = Math.max(0, table.scrollWidth - table.clientWidth);
      const overflows = maxScroll > 2;
      wrap.dataset.canScrollLeft = String(overflows && table.scrollLeft > 2);
      wrap.dataset.canScrollRight = String(overflows && table.scrollLeft < maxScroll - 2);
    };

    table.addEventListener('scroll', updateScrollState, { passive: true });
    if (typeof ResizeObserver === 'function') {
      new ResizeObserver(updateScrollState).observe(table);
    } else {
      window.addEventListener('resize', updateScrollState, { passive: true });
    }
    updateScrollState();
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '.geary-prose a[href^="http://"], .geary-prose a[href^="https://"]',
  )) {
    try {
      if (new URL(link.href).origin === window.location.origin) continue;
    } catch {
      continue;
    }
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    if (!link.querySelector('.sr-only')) {
      const note = document.createElement('span');
      note.className = 'sr-only';
      note.textContent = ' (opens in new tab)';
      link.appendChild(note);
    }
  }

  const copyText = async (text: string): Promise<boolean> => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback below for non-HTTPS LAN origins or restricted mobile contexts
      }
    }
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    ta.style.pointerEvents = 'none';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, text.length);
    let ok = false;
    try {
      const legacyCopy = (document as unknown as { execCommand?: (cmd: string) => boolean })
        .execCommand;
      ok = typeof legacyCopy === 'function' ? legacyCopy.call(document, 'copy') : false;
    } catch {
      ok = false;
    }
    document.body.removeChild(ta);
    return ok;
  };

  for (const heading of document.querySelectorAll('.geary-prose h2[id], .geary-prose h3[id]')) {
    const id = heading.getAttribute('id');
    const title = heading.textContent?.trim();
    if (!id || !title || heading.querySelector('.heading-anchor')) continue;

    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${id}`;
    anchor.setAttribute('aria-label', `Link to ${title}`);
    anchor.textContent = '#';
    anchor.addEventListener('click', () => {
      const url = `${window.location.origin}${window.location.pathname}#${id}`;
      void copyText(url);
    });
    heading.appendChild(anchor);
  }

  const shareBtn = document.getElementById('article-native-share');
  if (shareBtn && typeof navigator.share === 'function') {
    shareBtn.classList.remove('hidden');
    shareBtn.classList.add('inline-flex');
    shareBtn.addEventListener('click', () => {
      const title = shareBtn.getAttribute('data-share-title') || document.title;
      const url = shareBtn.getAttribute('data-share-url') || window.location.href;
      navigator.share({ title, url }).catch(() => {});
    });
  }

  const copyBtn = document.getElementById('article-copy-link');
  const copyLabel = document.getElementById('article-copy-label');
  if (copyBtn && copyLabel) {
    let resetTimer: number | undefined;
    copyBtn.addEventListener('click', () => {
      void copyText(window.location.href).then((ok) => {
        if (!ok) return;
        copyLabel.textContent = 'Copied';
        copyLabel.classList.remove('hidden');
        copyBtn.classList.add('text-brand-crimson');
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          copyLabel.classList.add('hidden');
          copyBtn.classList.remove('text-brand-crimson');
        }, 1800);
      });
    });
  }
</script>
