---
import { getArticlePreview, getArticleSlug, type ArticleLike } from '../lib/articles';

interface Props {
  article: ArticleLike;
}

const { article } = Astro.props;
const slug = getArticleSlug(article);
const preview = getArticlePreview(article);
---

<a
  href={`/articles/${slug}`}
  class="group flex flex-col justify-between rounded-xl border border-border-subtle bg-surface-card p-5 transition-colors duration-150 hover:border-brand-crimson"
>
  <h3 class="font-heading text-base font-semibold leading-snug text-ink-primary group-hover:text-brand-crimson transition-colors duration-150">
    {article.data.title}
  </h3>

  <div class="mt-1.5 flex items-end justify-between gap-3">
    <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-ink-secondary">
      {preview}
    </p>
    <span
      aria-hidden="true"
      class="inline-flex h-[1.625em] shrink-0 items-center text-sm text-brand-crimson group-hover:translate-x-0.5 group-hover:text-brand-crimson-hover transition-all duration-150"
    >
      <svg
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        class="h-3.5 w-3.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 8h9M9 4.5 12.5 8 9 11.5" />
      </svg>
    </span>
  </div>
</a>
